---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import { profile as englishProfile } from '../data/en/profile';
import { profile as persianProfile } from '../data/fa/profile';
import type { Locale } from '../i18n/config';
import { toLocalizedPath } from '../i18n/paths';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  jsonLd?: object;
  locale: Locale;
}

const { title, description, currentPath = '/', jsonLd, locale } = Astro.props;
const profile = locale === 'fa' ? persianProfile : englishProfile;
const canonical = new URL(toLocalizedPath(locale, currentPath), Astro.site ?? 'https://amirhossein-danesh.ir').toString();
const schema = jsonLd ?? (currentPath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  description,
  url: 'https://amirhossein-danesh.ir',
  sameAs: profile.socialLinks.filter((link) => link.external && link.href).map((link) => link.href),
} : undefined);
const englishUrl = new URL(toLocalizedPath('en', currentPath), Astro.site ?? 'https://amirhossein-danesh.ir').toString();
const persianUrl = new URL(toLocalizedPath('fa', currentPath), Astro.site ?? 'https://amirhossein-danesh.ir').toString();
---
<!doctype html>
<html lang={locale} dir={locale === 'fa' ? 'rtl' : 'ltr'} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="fa" href={persianUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : system;
        } catch { document.documentElement.dataset.theme = 'light'; }
      })();
    </script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <SiteNav currentPath={currentPath} locale={locale} />
      <slot />
      <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><a href={toLocalizedPath(locale, '/resume')}>{locale === 'fa' ? 'رزومه' : 'Resume'} {locale === 'fa' ? '↖' : '↗'}</a></footer>
    </div>
  </body>
</html>

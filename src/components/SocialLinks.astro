---
import type { SocialLink } from '../data/profile';
const { links } = Astro.props as { links: readonly SocialLink[] };
---
<div class="social-links" aria-label="External links">
  {links.filter((link) => link.href).map((link) => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}{link.external ? ' ↗' : ''}</a>)}
</div>

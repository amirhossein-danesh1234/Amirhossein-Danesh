---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHeader from './PageHeader.astro'; import ProjectItem from './ProjectItem.astro'; import type { Locale } from '../i18n/config'; import type { Project } from '../data/en/projects'; import { messages } from '../i18n/messages';
type Profile = { name: string }; const { locale, profile, projects } = Astro.props as { locale: Locale; profile: Profile; projects: Project[] }; const copy = messages[locale];
---
<BaseLayout title={`${copy.nav.projects} — ${profile.name}`} description={copy.pages.projects.description} currentPath="/projects" locale={locale}><main class="content-page"><PageHeader eyebrow={copy.pages.projects.eyebrow} title={copy.pages.projects.title} description={copy.pages.projects.description} /><div class="list">{projects.map((project) => <ProjectItem locale={locale} project={project} />)}</div></main></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro'; import KeyPhraseText from './KeyPhraseText.astro'; import type { Locale } from '../i18n/config'; import type { Project } from '../data/en/projects'; import type { SkillGroup } from '../data/en/skills'; import type { WorkEntry } from '../data/en/work'; import { messages } from '../i18n/messages';
type Profile = { name: string; title: string; bio: string }; type Academic = { university: string; degree: string }; const { locale, profile, work, projects, academic, skills } = Astro.props as { locale: Locale; profile: Profile; work: WorkEntry[]; projects: Project[]; academic: Academic; skills: SkillGroup[] }; const copy = messages[locale];
---
<BaseLayout title={`${copy.nav.resume} — ${profile.name}`} description={`${copy.nav.resume} — ${profile.name}`} currentPath="/resume" locale={locale}><main class="resume-page"><div class="resume-heading"><div><p class="eyebrow">{copy.pages.resume.eyebrow}</p><h1>{profile.name}</h1><p><KeyPhraseText text={profile.title} phrases={locale === 'fa' ? ['دانشجوی فیزیک و علوم کامپیوتر'] : ['Physics & Computer Science Student']} greenPhrases={locale === 'fa' ? ['محصول و عملیات فنی'] : ['Product & Technical Operations']} /></p></div></div><section class="resume-section"><h2>{copy.pages.resume.profile}</h2><p><KeyPhraseText text={profile.bio} phrases={locale === 'fa' ? ['ماینور علوم کامپیوتر'] : ['minor in computer science']} greenPhrases={locale === 'fa' ? ['محصول‌های واقعی', 'محصولات فناوری عمیق'] : ['useful products', 'deep-tech products']} /></p></section><section class="resume-section"><h2>{copy.pages.resume.work}</h2>{work.map((entry) => <div class="resume-entry"><h3 class="key-phrase--green">{entry.organization}</h3><p class="muted">{entry.role}{entry.startDate && ` · ${entry.startDate} — ${entry.endDate || (locale === 'fa' ? 'فعلی' : 'Present')}`}</p>{entry.description && <p><KeyPhraseText text={entry.description} greenPhrases={locale === 'fa' ? ['محصولی دیجیتال', 'هماهنگی فنی'] : ['digital B2B product', 'product, technology, and delivery']} /></p>}</div>)}</section><section class="resume-section"><h2>{copy.pages.resume.projects}</h2>{projects.map((project) => <div class="resume-entry"><h3 class={['physics-workspace', 'personal-ai-agent'].includes(project.slug) ? 'key-phrase' : 'key-phrase--green'}>{project.title}</h3>{project.role && <p class="muted">{project.role}</p>}{project.description && <p>{project.description}</p>}</div>)}</section><section class="resume-section"><h2>{copy.pages.resume.academic}</h2><div class="resume-entry"><h3 class="key-phrase">{academic.degree}</h3><p class="key-phrase">{academic.university}</p></div></section><section class="resume-section"><h2>{copy.pages.resume.areas}</h2><p>{skills.map((skill) => skill.name).join(' · ')}</p></section></main></BaseLayout>

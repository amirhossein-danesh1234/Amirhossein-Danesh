---
interface Props { label: string; number: string; description: string; href: string; linkLabel: string; }
const { label, number, description, href, linkLabel } = Astro.props;
---
<section class="home-section">
  <div class="section-label">{label} <span>/ {number}</span></div>
  <div class="home-section__body"><div><p class="home-section__description">{description}</p><slot /></div><a class="text-link" href={href}>{linkLabel} →</a></div>
</section>

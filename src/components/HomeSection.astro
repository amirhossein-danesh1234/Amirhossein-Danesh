---
interface Props { label: string; number: string; description: string; href: string; linkLabel: string; tone?: string; }
const { label, number, description, href, linkLabel, tone = 'default' } = Astro.props;
---
<section class:list={["home-section", `home-section--${tone}`]}>
  <div class="home-section__header"><div class="section-label"><i aria-hidden="true"></i>{label}</div><span class="section-number">{number}</span></div>
  <div class="home-section__body"><div><p class="home-section__description">{description}</p><slot /></div><a class="text-link" href={href}>{linkLabel} →</a></div>
</section>

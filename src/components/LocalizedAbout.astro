---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHeader from './PageHeader.astro'; import type { Locale } from '../i18n/config'; import { messages } from '../i18n/messages';
type Profile = { name: string; bio: string }; const { locale, profile } = Astro.props as { locale: Locale; profile: Profile }; const copy = messages[locale];
---
<BaseLayout title={`${copy.nav.about} — ${profile.name}`} description={copy.pages.about.description} currentPath="/about" locale={locale}><main class="content-page"><PageHeader eyebrow={copy.pages.about.eyebrow} title={copy.pages.about.title} description={copy.pages.about.description} /><div class="prose"><p>{profile.bio}</p></div></main></BaseLayout>

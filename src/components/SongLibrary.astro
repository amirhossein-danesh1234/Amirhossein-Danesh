<section class="library" id="library" aria-labelledby="library-heading" hidden>
  <header class="library-cover">
    <div class="cover-copy">
      <h1 id="library-heading">دفتر تمرین هم‌نوا</h1>
      <p>متن و آکورد برای هم‌خوانی و تمرین با پیانو، تار و سه‌تار</p>
      <label class="cover-search">
        <span class="sr-only">جست‌وجوی قطعه</span>
        <i class="search-glass" aria-hidden="true"></i>
        <input id="library-search" type="search" placeholder="جست‌وجوی نام قطعه، خواننده یا ساز" />
      </label>
    </div>
  </header>
  <div class="catalog-heading">
    <h2>قطعه‌ها</h2>
    <span id="library-count" role="status"></span>
  </div>
  <div id="piece-list" class="song-list"></div>
</section>

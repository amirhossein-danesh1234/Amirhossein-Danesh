---
import '../styles/peyda.css';
import '../music/music.css';
import '../music/notebook.css';
import SongLibrary from './SongLibrary.astro';
import SongPage from './SongPage.astro';
import AdminSongList from './AdminSongList.astro';
import AdminSongEditor from './AdminSongEditor.astro';

const { admin = false } = Astro.props as { admin?: boolean };
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="دفتر اجرای امیرحسین دانش برای پیانو، تار، سه‌تار و هم‌خوانی." />
    <title>{admin ? "مدیریت هم‌نوا" : "هم‌نوا | دفتر تمرین و اجرا"}</title>
    {admin ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href="https://music.amirhossein-danesh.ir/" />}
    <link rel="icon" href="/brand/hamnava-icon-round.svg" type="image/svg+xml" sizes="any" />
  </head>
  <body data-music-mode={admin ? "admin" : "public"}>
    <header class="top">
      <nav class="wrap top-inner" aria-label="ناوبری اصلی">
        <a class="brand" href="/"><img class="brand-icon" src="/brand/hamnava-logo.png" width="36" height="36" alt="" /> {admin ? "مدیریت هم‌نوا" : "هم‌نوا"}</a>
        {admin ? <a class="profile" href="https://music.amirhossein-danesh.ir/">سایت هم‌نوا</a> : <div class="public-nav"><a href="/">قطعه‌ها</a><a class="profile" href="https://amirhossein-danesh.ir/fa/">امیرحسین دانش <span aria-hidden="true">↖</span></a></div>}
      </nav>
    </header>
    <main class="wrap">
      <div id="notice" role="status" hidden></div>
      {!admin && <SongLibrary />}
      <AdminSongList />
      <AdminSongEditor />
      <SongPage {admin} />
    </main>
    <footer class="wrap footer">هم‌نوا · دفتر موسیقی امیرحسین دانش</footer>
    <noscript>برای نمایش قطعه‌ها و تغییر آکوردها، جاوااسکریپت را فعال کنید.</noscript>
    <script>
      import '../music/client';
    </script>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHeader from './PageHeader.astro'; import type { Locale } from '../i18n/config'; import { messages } from '../i18n/messages';
type Profile = { name: string }; type Academic = { university: string; degree: string; minor: string; selectedCoursework: string[]; activities: string[]; researchInterests: string[]; events: string[] };
const { locale, profile, academic } = Astro.props as { locale: Locale; profile: Profile; academic: Academic }; const copy = messages[locale]; const sections = [{ label: copy.academic.coursework, items: academic.selectedCoursework }, { label: copy.academic.activities, items: academic.activities }, { label: copy.academic.research, items: academic.researchInterests }, { label: copy.academic.events, items: academic.events }];
---
<BaseLayout title={`${copy.nav.academic} — ${profile.name}`} description={copy.pages.academic.description} currentPath="/academic" locale={locale}><main class="content-page"><PageHeader eyebrow={copy.pages.academic.eyebrow} title={academic.degree} description={academic.university} /><div class="academic-primary"><p class="eyebrow">{copy.academic.university}</p><h2>{academic.university}</h2><p class="muted">{academic.minor}</p></div>{sections.filter((section) => section.items.length > 0).map((section) => <section class="subsection"><h2>{section.label}</h2><ul>{section.items.map((item) => <li>{item}</li>)}</ul></section>)}</main></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WorkItem from '../components/WorkItem.astro';
import { work } from '../data/work';
---
<BaseLayout title="Work — AmirHossein Danesh" description="Professional work and experience for AmirHossein Danesh." currentPath="/work">
  <main class="content-page"><PageHeader eyebrow="WORK" title="Product and technical operations." description="Selected professional work, kept concise and easy to extend." /><div class="list">{work.map((entry) => <WorkItem entry={entry} />)}</div></main>
</BaseLayout>
